{
	"name": "api",
	"version": "1.0.2",
	"description": "Multi-purpose REST API server for kimzuni-labs",
	"type": "module",
	"module": "src/index.js",
	"private": true,
	"scripts": {
		"test": "NODE_ENV=test bun test",
		"test:coverage": "NODE_ENV=test bun test --coverage",
		"dev": "NODE_ENV=development bun run --watch --no-clear-screen src/index.ts",
		"start": "NODE_ENV=production bun run src/index.ts",
		"lint": "run-s lint:*",
		"lint:markdown": "markdownlint-cli2 .",
		"lint:yaml": "yamllint-js .",
		"lint:eslint": "eslint .",
		"prepare": "husky"
	},
	"dependencies": {
		"@elysia/cors": "rc",
		"@elysia/openapi": "rc",
		"elysia": "rc",
		"i18next": "^26.4.2",
		"nodemailer": "^10.0.10"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@elysia/eden": "rc",
		"@eslint/js": "^10.0.1",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/git": "^11.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"bun-types": "^1.4.2",
		"eslint": "^10.10.0",
		"husky": "^9.1.7",
		"markdownlint-cli2": "^0.23.2",
		"npm-run-all": "^4.1.5",
		"semantic-release": "^25.0.9",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"yamllint-js": "^0.2.4"
	},
	"patchedDependencies": {
		"@elysia/openapi@2.0.0-rc.0": "patches/@elysia%2Fopenapi@2.0.0-rc.0.patch"
	}
}
